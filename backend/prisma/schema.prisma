// SysOS — modelo de dados (escopo do protótipo: Cliente, Equipamento e Ordem de Serviço)
//
// Equipamento é ENTIDADE FRACA: não existe sem um Cliente e sua identificação
// é composta (clienteId + codigoInterno). O codigoInterno é a "chave parcial":
// numeração sequencial POR CLIENTE (1, 2, 3...), gerada pelo sistema (RN09).
// A OrdemServico referencia (clienteId, equipamentoCodigoInterno), o que garante
// no próprio banco a RN01 (equipamento da OS pertence ao cliente da OS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(150)

  // RN07: nome + ao menos um contato válido (CHECK na migration). CPF e
  // endereço NÃO são coletados (LGPD: coletar o mínimo).
  telefone String? @db.VarChar(15) // somente dígitos, com DDD
  email    String? @db.VarChar(254)

  // Contador da chave parcial dos equipamentos deste cliente.
  // Incrementado de forma atômica na mesma transação que cria o equipamento.
  proximoCodigoEquipamento Int @default(1)

  // RN22: quem fez e quando. criadoPorId vem do token (funcionário
  // autenticado); sem FK porque a tabela de contas pertence ao PB01/PB08.
  // atualizadoEm/atualizadoPorId: última correção do cadastro (nulos se nunca
  // alterado). Preenchidos pelo código, sem @updatedAt, para continuarem nulos
  // na criação.
  criadoEm        DateTime  @default(now())
  criadoPorId     Int
  atualizadoEm    DateTime?
  atualizadoPorId Int?

  equipamentos Equipamento[]

  @@index([nome])
  @@index([telefone])
  @@index([email])
}

model Equipamento {
  clienteId     Int
  codigoInterno Int // chave parcial (única dentro do cliente)

  tipo        String  @db.VarChar(60) // obrigatório (RF07)
  marca       String? @db.VarChar(60)
  modelo      String? @db.VarChar(80)
  numeroSerie String? @db.VarChar(80) // opcional (RN09)

  criadoEm        DateTime  @default(now())
  criadoPorId     Int
  atualizadoEm    DateTime?
  atualizadoPorId Int?

  // RN20: cliente com equipamento/OS não pode ser excluído (Restrict).
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  ordensServico OrdemServico[]

  @@id([clienteId, codigoInterno])
}

// PB04/PB05 — Ordem de serviço. O número é gerado pelo sistema, único e nunca
// muda (RN03); o status inicial é sempre "Aguardando Diagnóstico" (RN04).
// A FK composta com Equipamento garante RN01 e, junto com ON DELETE RESTRICT,
// RN20 (nada apaga o histórico: equipamento/cliente com OS não são excluídos).
// Como o Cliente é dono do Equipamento, o cliente da OS é o clienteId desta FK.
model OrdemServico {
  numero Int @id @default(autoincrement())

  clienteId                Int
  equipamentoCodigoInterno Int

  problemaRelatado String @db.VarChar(1000) // obrigatório (RN02); CHECK não vazio na migration
  status           String @default("Aguardando Diagnóstico") @db.VarChar(40)

  // RN22: quem fez e quando (sem FK: contas pertencem ao PB01/PB08)
  criadoEm    DateTime @default(now())
  criadoPorId Int

  equipamento Equipamento @relation(fields: [clienteId, equipamentoCodigoInterno], references: [clienteId, codigoInterno], onDelete: Restrict, onUpdate: Restrict)

  @@index([clienteId, status])
  @@index([status])
  @@index([clienteId, equipamentoCodigoInterno])
}