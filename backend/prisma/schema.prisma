// SysOS — modelo de dados (escopo do protótipo: Cliente e Equipamento)
//
// Equipamento é ENTIDADE FRACA: não existe sem um Cliente e sua identificação
// é composta (clienteId + codigoInterno). O codigoInterno é a "chave parcial":
// numeração sequencial POR CLIENTE (1, 2, 3...), gerada pelo sistema (RN09).
// Uma futura OS referenciará (clienteId, codigoInterno), o que garante no
// próprio banco a RN01 (equipamento da OS pertence ao cliente da OS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(150)

  // RN07: nome + ao menos um contato válido (CHECK na migration). CPF e
  // endereço NÃO são coletados (LGPD: coletar o mínimo).
  telefone String? @db.VarChar(15) // somente dígitos, com DDD
  email    String? @db.VarChar(254)

  // Contador da chave parcial dos equipamentos deste cliente.
  // Incrementado de forma atômica na mesma transação que cria o equipamento.
  proximoCodigoEquipamento Int @default(1)

  // RN22: quem fez e quando. criadoPorId vem do token (funcionário
  // autenticado); sem FK porque a tabela de contas pertence ao PB01/PB08.
  criadoEm    DateTime @default(now())
  criadoPorId Int

  equipamentos Equipamento[]

  @@index([nome])
  @@index([telefone])
  @@index([email])
}

model Equipamento {
  clienteId     Int
  codigoInterno Int // chave parcial (única dentro do cliente)

  tipo        String  @db.VarChar(60) // obrigatório (RF07)
  marca       String? @db.VarChar(60)
  modelo      String? @db.VarChar(80)
  numeroSerie String? @db.VarChar(80) // opcional (RN09)

  criadoEm    DateTime @default(now())
  criadoPorId Int

  // RN20: cliente com equipamento/OS não pode ser excluído (Restrict).
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([clienteId, codigoInterno])
}
