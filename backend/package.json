{
  "name": "sysos-backend",
  "version": "0.1.0",
  "description": "SysOS - protótipo do backend: cadastro de clientes e equipamentos",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "test:int": "node --env-file=.env node_modules/jest/bin/jest.js integracao",
    "test:cov": "jest --coverage",
    "token:dev": "tsx --env-file=.env scripts/gerar-token-dev.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.6"
  }
}
